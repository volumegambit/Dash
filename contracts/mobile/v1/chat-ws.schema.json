{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mobile-chat-ws",
  "$defs": {
    "ConversationId": {
      "$comment": "A user conversation id is a uuid; a sub-agent conversation id is sub_<ulid> (design 2026-09-04 sub-agents, 7.4). Child conversations stream over the same frames, so every conversationId accepts either shape.",
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|sub_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26})$"
    },
    "MobileImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "data"],
      "properties": {
        "mediaType": {
          "enum": ["image/jpeg", "image/png", "image/gif", "image/webp"]
        },
        "data": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "MobilePreciseLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "accuracyMeters", "capturedAt"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "accuracyMeters": {
          "type": "number",
          "minimum": 0
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339. May predate the message - clients may send a cached fix."
        },
        "place": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "MobileClientLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "utcOffsetMinutes", "locale"],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "IANA time zone id, e.g. \"Asia/Singapore\"."
        },
        "utcOffsetMinutes": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840,
          "description": "Minutes EAST of UTC at send time (Singapore = 480). JS getTimezoneOffset() is west-positive and must be negated; Swift secondsFromGMT() is already east-positive."
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "region": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "description": "ISO 3166-1 alpha-2."
        },
        "precise": {
          "$ref": "#/$defs/MobilePreciseLocation"
        }
      }
    },
    "MobileApiErrorCode": {
      "enum": [
        "unauthorized",
        "not_found",
        "validation_failed",
        "revision_conflict",
        "conversation_busy",
        "rate_limited",
        "gateway_offline",
        "capability_required",
        "too_large",
        "too_long",
        "provider",
        "network",
        "unavailable",
        "invalid"
      ]
    },
    "SpeechErrorCode": {
      "$comment": "packages/speech/src/errors.ts's SpeechErrorCode, restated here. The subset of MobileApiErrorCode a voice_error frame can actually carry.",
      "enum": [
        "unauthorized",
        "unavailable",
        "too_long",
        "too_large",
        "invalid",
        "provider",
        "network"
      ]
    },
    "ChatSend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "agentId", "channelId", "conversationId", "text", "resumable"],
      "properties": {
        "type": { "const": "message" },
        "id": { "type": "string", "format": "uuid" },
        "agentId": { "type": "string", "minLength": 1 },
        "channelId": { "type": "string", "minLength": 1 },
        "conversationId": { "$ref": "#/$defs/ConversationId" },
        "text": { "type": "string" },
        "location": { "$ref": "#/$defs/MobileClientLocation" },
        "modality": { "enum": ["text", "voice"] },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MobileImage"
          }
        },
        "streamingBehavior": {
          "enum": ["steer", "followUp"]
        },
        "resumable": {
          "const": true
        }
      }
    },
    "ChatResume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "agentId", "conversationId", "sinceSeq"],
      "properties": {
        "type": { "const": "resume" },
        "id": { "type": "string", "format": "uuid" },
        "agentId": { "type": "string", "minLength": 1 },
        "conversationId": { "$ref": "#/$defs/ConversationId" },
        "sinceSeq": { "type": "integer", "minimum": 0 }
      }
    },
    "ChatAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "questionId", "answer"],
      "properties": {
        "type": {
          "const": "answer"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "ChatCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "const": "cancel"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "ChatSubscribe": {
      "$comment": "Watch a conversation this socket did not start a turn on (design 2026-09-04 sub-agents, 7.6). `message` and `resume` subscribe implicitly.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "agentId", "conversationId"],
      "properties": {
        "type": { "const": "subscribe" },
        "id": { "type": "string", "format": "uuid" },
        "agentId": { "type": "string", "minLength": 1 },
        "conversationId": { "$ref": "#/$defs/ConversationId" }
      }
    },
    "ChatUnsubscribe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "agentId", "conversationId"],
      "properties": {
        "type": { "const": "unsubscribe" },
        "id": { "type": "string", "format": "uuid" },
        "agentId": { "type": "string", "minLength": 1 },
        "conversationId": { "$ref": "#/$defs/ConversationId" }
      }
    },
    "ChatAccepted": {
      "$comment": "`requestId` echoes SubagentResumeRequest.requestId on the turn that request became; it is LIVE-ONLY and never replayed, since the durable event log stores no client correlation id. `origin` and `kind` are optional. On a live frame they are emitted only when the turn is not an ordinary user turn on a user conversation, so pre-subscription clients see unchanged bytes, and absent means 'user'. On the replay path they are never emitted (the durable event-log payload does not carry them yet), so absent there means unknown -- read ConversationMessage.origin and ConversationSummary.kind instead.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "userMessageId",
        "assistantMessageId",
        "revision",
        "seq"
      ],
      "properties": {
        "type": { "const": "accepted" },
        "id": { "type": "string", "format": "uuid" },
        "conversationId": { "$ref": "#/$defs/ConversationId" },
        "userMessageId": { "type": "string", "format": "uuid" },
        "assistantMessageId": { "type": "string", "format": "uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "seq": { "type": "integer", "minimum": 1 },
        "origin": { "enum": ["user", "notification", "parent"] },
        "kind": { "enum": ["user", "subagent"] },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "ChatEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "conversationId", "seq", "event"],
      "properties": {
        "type": { "const": "event" },
        "id": { "type": "string", "format": "uuid" },
        "conversationId": { "$ref": "#/$defs/ConversationId" },
        "seq": { "type": "integer", "minimum": 1 },
        "event": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      }
    },
    "ChatDone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "conversationId", "seq", "outcome"],
      "properties": {
        "type": { "const": "done" },
        "id": { "type": "string", "format": "uuid" },
        "conversationId": { "$ref": "#/$defs/ConversationId" },
        "seq": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["completed", "cancelled"] }
      }
    },
    "ChatError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "conversationId", "seq", "error"],
      "properties": {
        "type": { "const": "error" },
        "id": { "type": "string", "format": "uuid" },
        "conversationId": { "$ref": "#/$defs/ConversationId" },
        "seq": { "type": "integer", "minimum": 1 },
        "error": { "type": "string", "minLength": 1 },
        "code": { "$ref": "#/$defs/MobileApiErrorCode" },
        "retryable": { "type": "boolean" },
        "activeTurnId": { "type": "string", "minLength": 1 }
      }
    },
    "MobileWsMessageFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "agentId", "channelId", "conversationId", "text"],
      "properties": {
        "type": { "const": "message" },
        "id": { "type": "string", "format": "uuid" },
        "agentId": { "type": "string", "minLength": 1 },
        "channelId": { "type": "string", "minLength": 1 },
        "conversationId": { "$ref": "#/$defs/ConversationId" },
        "text": { "type": "string" },
        "location": { "$ref": "#/$defs/MobileClientLocation" },
        "modality": { "enum": ["text", "voice"] },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MobileImage"
          }
        },
        "streamingBehavior": {
          "enum": ["steer", "followUp"]
        },
        "resumable": {
          "type": "boolean"
        }
      }
    },
    "MobileWsEventFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "event"],
      "properties": {
        "type": { "const": "event" },
        "id": { "type": "string", "format": "uuid" },
        "conversationId": { "$ref": "#/$defs/ConversationId" },
        "seq": { "type": "integer", "minimum": 1 },
        "event": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      }
    },
    "MobileWsDoneFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "done" },
        "id": { "type": "string", "format": "uuid" },
        "conversationId": { "$ref": "#/$defs/ConversationId" },
        "seq": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["completed", "cancelled"] }
      }
    },
    "MobileWsErrorFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "error"],
      "properties": {
        "type": { "const": "error" },
        "id": { "type": "string", "format": "uuid" },
        "conversationId": { "$ref": "#/$defs/ConversationId" },
        "seq": { "type": "integer", "minimum": 1 },
        "error": { "type": "string", "minLength": 1 },
        "code": { "$ref": "#/$defs/MobileApiErrorCode" },
        "retryable": { "type": "boolean" },
        "activeTurnId": { "type": "string", "minLength": 1 }
      }
    },
    "VoiceStart": {
      "$comment": "Starts the hands-free voice session on conversationId. id is the client-generated session id carried by every voice_* frame in both directions; a second voice_start on the same socket replaces the first session.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "agentId", "conversationId"],
      "properties": {
        "type": { "const": "voice_start" },
        "id": { "type": "string", "format": "uuid" },
        "agentId": { "type": "string", "minLength": 1 },
        "conversationId": { "$ref": "#/$defs/ConversationId" }
      }
    },
    "VoiceAudio": {
      "$comment": "One capture chunk from the phone's microphone. The gateway caps the DECODED size of pcm at 16384 bytes (~512ms of 16 kHz mono PCM16). seq is advisory only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "seq", "pcm"],
      "properties": {
        "type": { "const": "voice_audio" },
        "id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 0 },
        "pcm": {
          "description": "Standard base64 PCM16 at 16 kHz mono.",
          "type": "string",
          "minLength": 1,
          "contentEncoding": "base64"
        }
      }
    },
    "VoiceMute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "muted"],
      "properties": {
        "type": { "const": "voice_mute" },
        "id": { "type": "string", "format": "uuid" },
        "muted": { "type": "boolean" }
      }
    },
    "VoiceStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "voice_stop" },
        "id": { "type": "string", "format": "uuid" }
      }
    },
    "VoiceState": {
      "$comment": "turnId is set once a turn is running and cleared once it settles back to listening.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "state"],
      "properties": {
        "type": { "const": "voice_state" },
        "id": { "type": "string", "format": "uuid" },
        "state": {
          "enum": ["listening", "transcribing", "thinking", "speaking", "muted", "stopped"]
        },
        "turnId": { "type": "string", "format": "uuid" }
      }
    },
    "VoiceTranscript": {
      "$comment": "turnId is set on the transcript that STARTS a turn, always emitted before that turn's ChatAccepted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "text", "final"],
      "properties": {
        "type": { "const": "voice_transcript" },
        "id": { "type": "string", "format": "uuid" },
        "text": { "type": "string" },
        "final": { "type": "boolean" },
        "turnId": { "type": "string", "format": "uuid" }
      }
    },
    "VoiceSpeech": {
      "$comment": "seq is a per-chunk counter, independent of the resumable chat hub's seq.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "seq", "audio", "format", "text"],
      "properties": {
        "type": { "const": "voice_speech" },
        "id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 0 },
        "audio": {
          "description": "base64 of the chunk's raw bytes.",
          "type": "string",
          "minLength": 1,
          "contentEncoding": "base64"
        },
        "format": { "enum": ["pcm16", "mp3"] },
        "sampleRate": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" }
      }
    },
    "VoiceError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "code", "error"],
      "properties": {
        "type": { "const": "voice_error" },
        "id": { "type": "string", "format": "uuid" },
        "code": { "$ref": "#/$defs/SpeechErrorCode" },
        "error": { "type": "string", "minLength": 1 }
      }
    },
    "VoiceStopped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "reason"],
      "properties": {
        "type": { "const": "voice_stopped" },
        "id": { "type": "string", "format": "uuid" },
        "reason": { "enum": ["client", "socket", "provider", "replaced"] }
      }
    },
    "MobileWsClientFrame": {
      "oneOf": [
        { "$ref": "#/$defs/MobileWsMessageFrame" },
        { "$ref": "#/$defs/ChatResume" },
        { "$ref": "#/$defs/ChatAnswer" },
        { "$ref": "#/$defs/ChatCancel" },
        { "$ref": "#/$defs/ChatSubscribe" },
        { "$ref": "#/$defs/ChatUnsubscribe" },
        { "$ref": "#/$defs/VoiceStart" },
        { "$ref": "#/$defs/VoiceAudio" },
        { "$ref": "#/$defs/VoiceMute" },
        { "$ref": "#/$defs/VoiceStop" }
      ]
    },
    "MobileWsServerFrame": {
      "oneOf": [
        {
          "$ref": "#/$defs/ChatAccepted"
        },
        {
          "$ref": "#/$defs/MobileWsEventFrame"
        },
        {
          "$ref": "#/$defs/MobileWsDoneFrame"
        },
        {
          "$ref": "#/$defs/MobileWsErrorFrame"
        },
        {
          "$ref": "#/$defs/VoiceState"
        },
        {
          "$ref": "#/$defs/VoiceTranscript"
        },
        {
          "$ref": "#/$defs/VoiceSpeech"
        },
        {
          "$ref": "#/$defs/VoiceError"
        },
        {
          "$ref": "#/$defs/VoiceStopped"
        }
      ]
    },
    "MobileWsFrame": {
      "oneOf": [
        {
          "$ref": "#/$defs/MobileWsClientFrame"
        },
        {
          "$ref": "#/$defs/MobileWsServerFrame"
        }
      ]
    }
  },
  "$ref": "#/$defs/MobileWsFrame"
}

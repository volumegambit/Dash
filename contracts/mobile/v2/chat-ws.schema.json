{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mobile-v2-chat-ws",
  "$defs": {
    "LegacyRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "[^ \\t\\r\\n]",
      "x-maxUtf8Bytes": 256
    },
    "CanonicalUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "MobileImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaType",
        "data"
      ],
      "properties": {
        "mediaType": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/gif",
            "image/webp"
          ]
        },
        "data": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "MobilePreciseLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "accuracyMeters",
        "capturedAt"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "accuracyMeters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
        },
        "place": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "MobileClientLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "utcOffsetMinutes",
        "locale"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "utcOffsetMinutes": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "region": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "precise": {
          "$ref": "#/$defs/MobilePreciseLocation"
        }
      }
    },
    "MobileApiErrorCode": {
      "enum": [
        "unauthorized",
        "not_found",
        "validation_failed",
        "revision_conflict",
        "conversation_busy",
        "rate_limited",
        "gateway_offline",
        "capability_required"
      ]
    },
    "MobileAgentEvent": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "MobileV2PendingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputId",
        "kind",
        "text",
        "state",
        "revision",
        "enqueueOrder",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "inputId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "kind": {
          "enum": [
            "steer",
            "follow_up"
          ]
        },
        "targetTurnId": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "text": {
          "type": "string"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MobileImage"
          }
        },
        "state": {
          "enum": [
            "queued",
            "delivering",
            "delivered",
            "removed",
            "failed"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "enqueueOrder": {
          "type": "integer",
          "minimum": 0
        },
        "runId": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "segmentTurnId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "userMessageId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "assistantMessageId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "failureCode": {
          "$ref": "#/$defs/MobileApiErrorCode"
        },
        "failureMessage": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "deliveredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ChatHello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "contractVersion",
        "capabilities"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "contractVersion": {
          "const": 2
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ChatSubscribe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "agentId",
        "conversationId",
        "sinceV2Seq"
      ],
      "properties": {
        "type": {
          "const": "subscribe_conversation"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "sinceV2Seq": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ChatSend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "agentId",
        "channelId",
        "conversationId",
        "text",
        "resumable"
      ],
      "properties": {
        "type": {
          "const": "message"
        },
        "id": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "channelId": {
          "type": "string",
          "minLength": 1
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "text": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/MobileClientLocation"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MobileImage"
          }
        },
        "resumable": {
          "const": true
        }
      }
    },
    "ChatEnqueueInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "inputId",
        "agentId",
        "channelId",
        "conversationId",
        "text",
        "behavior"
      ],
      "properties": {
        "type": {
          "const": "enqueue_input"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "inputId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "channelId": {
          "type": "string",
          "minLength": 1
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "text": {
          "type": "string"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MobileImage"
          }
        },
        "behavior": {
          "enum": [
            "steer",
            "followUp"
          ]
        },
        "expectedActiveTurnId": {
          "$ref": "#/$defs/LegacyRunId"
        }
      },
      "if": {
        "properties": {
          "behavior": {
            "const": "steer"
          }
        }
      },
      "then": {
        "required": [
          "expectedActiveTurnId"
        ]
      },
      "else": {
        "not": {
          "required": [
            "expectedActiveTurnId"
          ]
        }
      }
    },
    "ChatEditFollowUp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "inputId",
        "expectedRevision",
        "text"
      ],
      "properties": {
        "type": {
          "const": "edit_follow_up"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "inputId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MobileImage"
          }
        }
      }
    },
    "ChatRemoveFollowUp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "inputId",
        "expectedRevision"
      ],
      "properties": {
        "type": {
          "const": "remove_follow_up"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "inputId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ChatResumeFollowUps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "expectedQueueRevision"
      ],
      "properties": {
        "type": {
          "const": "resume_follow_ups"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "expectedQueueRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ChatAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "questionId",
        "answer"
      ],
      "properties": {
        "type": {
          "const": "answer"
        },
        "id": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "ChatCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "cancel"
        },
        "id": {
          "$ref": "#/$defs/LegacyRunId"
        }
      }
    },
    "ChatHelloAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "contractVersion",
        "capabilities"
      ],
      "properties": {
        "type": {
          "const": "hello_ack"
        },
        "contractVersion": {
          "const": 2
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ChatConversationSubscribed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "v2ThroughSeq"
      ],
      "properties": {
        "type": {
          "const": "conversation_subscribed"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "v2ThroughSeq": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CommandRejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "code",
        "error",
        "retryable"
      ],
      "properties": {
        "type": {
          "const": "command_rejected"
        },
        "id": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "code": {
          "$ref": "#/$defs/MobileApiErrorCode"
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ChatAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "runId",
        "segmentTurnId",
        "v2Seq",
        "userMessageId",
        "assistantMessageId",
        "revision"
      ],
      "properties": {
        "type": {
          "const": "accepted"
        },
        "id": {
          "$ref": "#/$defs/LegacyRunId",
          "description": "Run identity. On sequenced model frames, id is identical to runId."
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "runId": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "segmentTurnId": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "v2Seq": {
          "type": "integer",
          "minimum": 0
        },
        "userMessageId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "assistantMessageId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ChatEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "runId",
        "segmentTurnId",
        "v2Seq",
        "event"
      ],
      "properties": {
        "type": {
          "const": "event"
        },
        "id": {
          "$ref": "#/$defs/LegacyRunId",
          "description": "Run identity. On sequenced model frames, id is identical to runId."
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "runId": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "segmentTurnId": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "v2Seq": {
          "type": "integer",
          "minimum": 0
        },
        "event": {
          "$ref": "#/$defs/MobileAgentEvent"
        }
      }
    },
    "ChatDone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "runId",
        "segmentTurnId",
        "v2Seq",
        "outcome"
      ],
      "properties": {
        "type": {
          "const": "done"
        },
        "id": {
          "$ref": "#/$defs/LegacyRunId",
          "description": "Run identity. On sequenced model frames, id is identical to runId."
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "runId": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "segmentTurnId": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "v2Seq": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "enum": [
            "completed",
            "cancelled",
            "interrupted"
          ]
        }
      }
    },
    "ChatError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "runId",
        "segmentTurnId",
        "v2Seq",
        "error"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "id": {
          "$ref": "#/$defs/LegacyRunId",
          "description": "Run identity. On sequenced model frames, id is identical to runId."
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "runId": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "segmentTurnId": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "v2Seq": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "$ref": "#/$defs/MobileApiErrorCode"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "InputAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "v2Seq",
        "queueRevision",
        "input"
      ],
      "properties": {
        "type": {
          "const": "input_accepted"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid",
          "description": "Originating command identity, or a server-generated transition identity for recovery and automatic terminalization."
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "v2Seq": {
          "type": "integer",
          "minimum": 0
        },
        "queueRevision": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "$ref": "#/$defs/MobileV2PendingInput"
        }
      }
    },
    "InputUpdated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "v2Seq",
        "queueRevision",
        "input"
      ],
      "properties": {
        "type": {
          "const": "input_updated"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid",
          "description": "Originating command identity, or a server-generated transition identity for recovery and automatic terminalization."
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "v2Seq": {
          "type": "integer",
          "minimum": 0
        },
        "queueRevision": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "$ref": "#/$defs/MobileV2PendingInput"
        }
      }
    },
    "InputRemoved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "v2Seq",
        "queueRevision",
        "input"
      ],
      "properties": {
        "type": {
          "const": "input_removed"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid",
          "description": "Originating command identity, or a server-generated transition identity for recovery and automatic terminalization."
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "v2Seq": {
          "type": "integer",
          "minimum": 0
        },
        "queueRevision": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "$ref": "#/$defs/MobileV2PendingInput"
        }
      }
    },
    "InputDelivered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "v2Seq",
        "queueRevision",
        "input",
        "runId",
        "segmentTurnId",
        "userMessageId",
        "assistantMessageId"
      ],
      "properties": {
        "type": {
          "const": "input_delivered"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid",
          "description": "Originating command identity, or a server-generated transition identity for recovery and automatic terminalization."
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "v2Seq": {
          "type": "integer",
          "minimum": 0
        },
        "queueRevision": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "$ref": "#/$defs/MobileV2PendingInput"
        },
        "runId": {
          "$ref": "#/$defs/LegacyRunId"
        },
        "segmentTurnId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "userMessageId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "assistantMessageId": {
          "$ref": "#/$defs/CanonicalUuid"
        }
      }
    },
    "InputFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "conversationId",
        "v2Seq",
        "queueRevision",
        "input"
      ],
      "properties": {
        "type": {
          "const": "input_failed"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid",
          "description": "Originating command identity, or a server-generated transition identity for recovery and automatic terminalization."
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "v2Seq": {
          "type": "integer",
          "minimum": 0
        },
        "queueRevision": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "$ref": "#/$defs/MobileV2PendingInput"
        }
      }
    },
    "QueuePaused": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "conversationId",
        "v2Seq",
        "queueRevision",
        "queuePaused",
        "pendingFollowUpCount"
      ],
      "properties": {
        "type": {
          "const": "queue_paused"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid",
          "description": "Originating command identity when present, otherwise a server-generated transition identity."
        },
        "conversationId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "v2Seq": {
          "type": "integer",
          "minimum": 0
        },
        "queueRevision": {
          "type": "integer",
          "minimum": 0
        },
        "queuePaused": {
          "type": "boolean"
        },
        "pendingFollowUpCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "QueueResumed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "conversationId",
        "v2Seq",
        "queueRevision",
        "queuePaused",
        "pendingFollowUpCount"
      ],
      "properties": {
        "type": {
          "const": "queue_resumed"
        },
        "id": {
          "$ref": "#/$defs/CanonicalUuid",

# Env vars override config/credentials.json (useful for CI, Docker, or temporary overrides).
# If you prefer JSON config, copy config.example/credentials.json to config/credentials.json.

# LLM Providers
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
OPENAI_API_KEY=sk-...

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_ALLOWED_USERS=123456789

# Logging (overrides config/dash.json)
LOG_LEVEL=info

# Mission Control remote-access sign-in (Clerk). Public values (PKCE, no secret):
# the OAuth client id and Frontend API host of the Clerk instance backing the
# hosted Dash relay. Loaded from this file by `npm run mc:dev`; packaged builds
# get them from the deployment environment instead.
DASH_CLERK_FRONTEND_API=your-instance.clerk.accounts.dev
DASH_CLERK_CLIENT_ID=xxxxxxxxxxxxxxxx
# Control-plane API origin (defaults to https://cp.dash.dev when unset)
# DASH_CONTROL_PLANE_URL=https://cp.dash.dev

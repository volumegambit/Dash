{
  "name": "@dash/gateway",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "plugins"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "node --import tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@dash/agent": "*",
    "@dash/plugins": "*",
    "@dash/channels": "*",
    "@dash/mcp": "*",
    "@dash/chat": "*",
    "@dash/logging": "*",
    "@dash/management": "*",
    "@dash/mobile-contract": "*",
    "@dash/paths": "*",
    "@dash/plugin-sdk": "*",
    "@dash/projects": "*",
    "@dash/relay": "*",
    "@dash/skills": "*",
    "@dash/swarm": "*",
    "@earendil-works/pi-ai": "^0.79.8",
    "@hono/node-server": "^1",
    "@hono/node-ws": "^1",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.0",
    "hono": "^4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0",
    "tsx": "^4.19.0"
  },
  "tsup": {
    "entry": ["src/index.ts"],
    "format": ["esm"],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "banner": {
      "js": "import { createRequire as _createRequire } from 'module'; const require = _createRequire(import.meta.url);"
    }
  }
}

# Copy to .env next to docker-compose.yml (chmod 600). deploy.sh rewrites
# DASH_SERVER_IMAGE on every deploy; everything else is per-environment.

# Written by deploy.sh — the image currently running. Leave as-is on first setup.
DASH_SERVER_IMAGE=ghcr.io/volumegambit/dash-server:staging

# Wildcard zone gateways are served under. The CP mints subdomains beneath it,
# Traefik requests a wildcard certificate for it. "api" is reserved for the CP.
# staging:    RELAY_ZONE=stg.relay.dash.volumegambit.com  CP_HOST=api.stg.relay.dash.volumegambit.com
# production: RELAY_ZONE=relay.dashsquad.ai               CP_HOST=api.relay.dashsquad.ai
RELAY_ZONE=stg.relay.dash.volumegambit.com
CP_HOST=api.stg.relay.dash.volumegambit.com

# Public URLs smoke.sh probes after a deploy. The relay probe uses any
# subdomain — a 401/502 through TLS proves the wildcard route is live.
CP_PUBLIC_URL=https://api.stg.relay.dash.volumegambit.com
RELAY_PROBE_URL=https://smoke.stg.relay.dash.volumegambit.com

# Shared secret between the control plane and the relay admin API.
# Generate: openssl rand -hex 32
ADMIN_SECRET=

# Clerk instance the control plane verifies ID tokens against. Must be the same
# application the web app's VITE_CLERK_PUBLISHABLE_KEY belongs to.
# staging: the dev instance below. production: the Clerk PRODUCTION instance's
# Frontend API host (e.g. clerk.dashsquad.ai once its custom domain is verified).
CLERK_FRONTEND_API=resolved-seahorse-39.clerk.accounts.dev
CLERK_CLIENT_ID=

# Browser origins allowed to call /v1/* (the deployed web app). Comma-separated, exact.
# staging: https://staging.dash-web.pages.dev   production: https://app.relay.dashsquad.ai
WEB_ORIGINS=https://staging.dash-web.pages.dev

# Traefik wiring — defaults match server-do.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=cfdns

# Not read by compose: the dial-token keypair lives in ./secrets/
#   openssl genpkey -algorithm ed25519 -out secrets/dial-token.key
#   openssl pkey -in secrets/dial-token.key -pubout -out secrets/dial-token.pub
#   chmod 600 secrets/dial-token.key
